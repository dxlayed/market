<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>My Shop | SplitzMarket</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;700;800&family=Manrope:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#0a0707;--surface:#140c0c;--raise:#1e1111;--line:#3a1717;--text:#f6efee;--mute:#a88a88;--gold:#e8202a;--violet:#8f0d14;--ok:#4ade80;--bad:#ff7a45}
*{box-sizing:border-box}
body{margin:0;font-family:Manrope,system-ui,sans-serif;background:var(--bg);color:var(--text)}
h1,h2,h3,.logo{font-family:Outfit,system-ui,sans-serif;margin:0}
button,input,select{font:inherit;color:var(--text);background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:9px 12px}
button{cursor:pointer;font-weight:700}
button:focus-visible,input:focus,select:focus,a:focus-visible{outline:2px solid var(--gold);outline-offset:1px}
button:disabled{opacity:.55;cursor:not-allowed}
.btn{background:var(--gold);color:#fff;border:0}.ghost{background:transparent}.sm{padding:6px 12px;font-size:13px;border-radius:8px}
.mute{color:var(--mute);font-size:13px}
.bar{display:flex;align-items:center;gap:14px;padding:12px 24px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.logo{font-size:22px;font-weight:800;text-decoration:none;color:var(--text)}.logo b{color:var(--gold)}
.bar nav{display:flex;gap:6px;margin-right:auto;flex-wrap:wrap}
.bar nav a{padding:8px 14px;border-radius:10px;color:var(--mute);text-decoration:none;font-weight:700}.bar nav a.on{background:var(--surface);color:var(--text);box-shadow:inset 0 -2px 0 var(--gold)}
.av{width:32px;height:32px;border-radius:9px;background:var(--violet);display:grid;place-items:center;font-weight:800;font-family:Outfit,sans-serif;flex:none}
.wrap{max-width:1180px;margin:0 auto;padding:28px 24px 60px}
.title{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;padding-bottom:18px;border-bottom:1px solid var(--line);margin-bottom:22px}
.title h1{font-size:30px}.title p{margin:6px 0 0;color:var(--mute)}
.notice{background:#e8202a14;border:1px solid #e8202a55;border-radius:12px;padding:12px 16px;margin-bottom:18px;font-size:14px}
.notice b{color:var(--gold)}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:20px;align-items:start}
.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:18px;margin-bottom:18px}
.card h2{font-size:18px;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;gap:10px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px}
.it{position:relative;background:var(--bg);border:1px solid var(--line);border-radius:14px;overflow:hidden;cursor:pointer;text-align:left;padding:0;display:flex;flex-direction:column;color:var(--text)}
.it.sel{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold)}
.it.busy{opacity:.55;cursor:default}
.it.listed{cursor:default;border-color:#e8202a66}
.it .down{margin:0 12px 12px;padding:6px 10px;font-size:13px;border-radius:8px}
.price{font-family:Outfit,sans-serif;font-weight:800;color:var(--text);display:block;font-size:18px;margin:2px 0}
.sellrow{display:flex;align-items:center;gap:10px;margin:14px 0 4px}.sellrow input{flex:1;font-size:20px;font-weight:800;font-family:Outfit,sans-serif}
.sellrow span{font-family:Outfit,sans-serif;font-size:22px;font-weight:800;color:var(--mute)}
.sumline{display:flex;justify-content:space-between;font-weight:700;margin-top:8px}
.sumline.big{font-size:17px;border-top:1px solid var(--line);padding-top:10px}.sumline.big span:last-child{color:#4ade80}
.totals{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:4px 14px 12px;margin-bottom:6px}
.setall{margin:14px 0 4px}.setall .two{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px}
.money{display:flex;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:0 10px}
.money:focus-within{outline:2px solid var(--gold);outline-offset:1px}
.money span{color:var(--mute);font-weight:800}.money em{font-style:normal;color:var(--mute);font-size:12px;white-space:nowrap}
.money input{border:0;background:transparent;width:100%;min-width:0;padding:9px 6px;font-weight:700}.money input:focus{outline:0}
.sitem{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:10px 12px}
.sitem .top{display:flex;align-items:center;gap:10px}
.sitem .ph{width:46px;height:46px;border-radius:10px;background:var(--raise);display:grid;place-items:center;flex:none;overflow:hidden}
.sitem .ph img{max-width:90%;max-height:90%}
.sitem .nm{flex:1;min-width:0}.sitem .nm b{display:block;overflow-wrap:anywhere}
.sitem .nm button{background:none;border:0;padding:0;color:#4ade80;font-size:12px;font-weight:800;cursor:pointer}
.sitem .nm small{color:var(--mute);font-size:12px;margin-left:6px}
.sitem .money{width:120px;flex:none}
.guide{display:flex;align-items:center;gap:12px;margin-top:10px}
.guide input[type=range]{flex:1;-webkit-appearance:none;appearance:none;height:8px;border-radius:99px;padding:0;border:0;cursor:pointer;
  background:linear-gradient(90deg,#22c55e 0%,#4ade80 30%,#a3e635 45%,#e6b422 62%,#ff7a45 80%,#e8202a 100%)}
.guide input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;border-radius:50%;background:#fff;border:4px solid #0a0707;box-shadow:0 0 0 2px #ffffff55,0 2px 8px #000a}
.guide input[type=range]::-moz-range-thumb{width:14px;height:14px;border-radius:50%;background:#fff;border:4px solid #0a0707}
.guide input[type=range]:focus{outline:0}.guide input[type=range]:focus-visible::-webkit-slider-thumb{box-shadow:0 0 0 4px #e8202a88}
.guide input[type=range]:disabled{opacity:.35;cursor:default}
.deal{min-width:104px;text-align:center;font-size:12px;font-weight:800;border-radius:99px;padding:4px 10px;background:var(--raise);color:var(--mute)}
.deal.steal{background:#22c55e26;color:#4ade80}.deal.good{background:#4ade801f;color:#86efac}.deal.fair{background:#e6b42222;color:#facc15}
.deal.pricey{background:#ff7a4526;color:#ff9a6b}.deal.over{background:#e8202a2e;color:#ff8a8f}
.vbox{text-align:right;display:flex;flex-direction:column;flex:none}.vbox b{font-family:Outfit,sans-serif}.vbox small{color:var(--mute);font-size:12px}
.art{height:100px;display:grid;place-items:center;background:radial-gradient(circle at 50% 55%,color-mix(in srgb,var(--c) 40%,transparent),transparent 70%),var(--raise);color:var(--c)}
.art img{max-width:80%;max-height:84px}.art svg{width:52px;height:52px}
.it .info{padding:10px 12px}
.it b{display:block;font-size:15px;overflow-wrap:anywhere}
.shophd{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:16px}
.shophd .av{width:56px;height:56px;border-radius:14px;font-size:22px}
.shophd h1{font-size:30px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.chip{font-family:Manrope,sans-serif;font-size:13px;font-weight:800;border-radius:99px;padding:3px 10px;background:var(--raise);color:var(--mute);border:1px solid var(--line)}
.chip.g{background:#4ade801a;color:#4ade80;border-color:#4ade8040}
.shophd .acts{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap}
.sums{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px;margin-bottom:16px}
.sums div{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px 14px}
.sums span{display:block;color:var(--mute);font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.04em}
.sums b{display:block;font-family:Outfit,sans-serif;font-size:24px;margin-top:2px}.sums em{font-style:normal;color:var(--mute);font-size:12px}
.sums .get{border-color:#4ade8055;background:linear-gradient(180deg,#4ade8012,var(--surface))}.sums .get b{color:#4ade80}
.stools{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:14px}.stools input{flex:1;min-width:180px}
.seg{display:flex;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:3px}
.seg button{border:0;background:transparent;color:var(--mute);border-radius:9px;padding:7px 14px;font-weight:800}
.seg button.on{background:var(--gold);color:#fff}
.qty{position:absolute;right:8px;bottom:8px;font-family:Outfit,sans-serif;font-weight:900;font-size:14px;background:#000b;border:1px solid var(--line);color:#fff;border-radius:8px;padding:1px 8px}
.it .stp{display:flex;align-items:center;justify-content:space-between;margin:0 12px 12px;background:var(--raise);border:1px solid var(--line);border-radius:9px;padding:2px}
.it .stp span{width:28px;height:26px;display:grid;place-items:center;border-radius:7px;font-weight:900;cursor:pointer}.it .stp span:hover{background:#341b1b}
.it .stp em{font-style:normal;font-weight:800;font-size:13px}
.it .each{color:var(--mute);font-size:12px;font-weight:700}
.it .tick{position:absolute;top:8px;right:8px;width:22px;height:22px;border-radius:6px;border:2px solid var(--line);background:var(--bg);display:grid;place-items:center;font-size:13px;font-weight:800;color:#fff}
.it.sel .tick{background:var(--gold);border-color:var(--gold)}
.tag{position:absolute;top:8px;left:8px;font-size:10px;font-weight:800;padding:2px 7px;border-radius:6px;background:#0009;border:1px solid var(--c);color:#fff}
.empty{text-align:center;color:var(--mute);padding:40px 16px}
.tr{background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:10px}
.tr .row{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
.botnote{display:flex;align-items:center;gap:9px;margin-top:10px;font-weight:700;font-size:14px}
.botnote .live{width:8px;height:8px;border-radius:50%;background:var(--gold);flex:none;animation:beat 2s infinite}
@keyframes beat{0%{box-shadow:0 0 0 0 #e8202a88}70%{box-shadow:0 0 0 8px #e8202a00}100%{box-shadow:0 0 0 0 #e8202a00}}
@media (prefers-reduced-motion:reduce){.botnote .live{animation:none}}
.pill{font-size:11px;font-weight:800;border-radius:99px;padding:2px 9px;background:var(--raise);color:var(--mute)}
.pill.pending,.pill.in_progress{background:#e8202a26;color:var(--gold)}.pill.completed{background:#4ade8022;color:var(--ok)}.pill.failed{background:#ff7a4526;color:var(--bad)}
.steps{margin:10px 0 0;padding-left:18px;color:var(--mute);font-size:13px;line-height:1.55}
.steps b{color:var(--text)}
dialog{background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:16px;width:min(560px,94vw);padding:22px}
dialog::backdrop{background:#000b}
.pick{display:flex;flex-direction:column;gap:6px;max-height:46vh;overflow-y:auto;margin:12px 0}
.pr{display:flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:8px 10px}
.pr span{flex:1;font-weight:700;overflow-wrap:anywhere}.pr small{color:var(--mute);font-weight:500}
.qty{display:flex;align-items:center;gap:6px}.qty button{padding:2px 10px}.qty output{min-width:22px;text-align:center;font-weight:800}
.err{color:var(--bad);font-size:14px;min-height:18px}
.gate{text-align:center;padding:60px 20px}
#toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--ok);color:#06240f;padding:10px 18px;border-radius:10px;font-weight:700;opacity:0;pointer-events:none;transition:opacity .2s}#toast.show{opacity:1}
@media (prefers-reduced-motion:reduce){#toast{transition:none}}
@media (max-width:900px){.layout{grid-template-columns:1fr}}

body{background:radial-gradient(ellipse 90% 60% at 50% -10%,#3a0a0d 0%,transparent 60%) fixed,var(--bg)}
.logo b{color:var(--gold);text-shadow:0 0 18px #e8202a88}
.btn{transition:filter .15s,box-shadow .15s}.btn:hover{filter:brightness(1.12);box-shadow:0 0 20px #e8202a55}
.card,.panel{transition:border-color .15s}.card:hover,.panel:hover{border-color:#5a1f1f}
::selection{background:#e8202a;color:#fff}
::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-thumb{background:#3a1717;border-radius:99px}::-webkit-scrollbar-track{background:transparent}
</style>
</head>
<body>
<div class="bar">
  <a class="logo" href="/">Splitz<b>Market</b></a>
  <nav><a href="/">Market</a><a class="on" href="/inventory.html">Inventory</a><a href="/support.html">Support</a></nav>
  <div id="who"></div>
</div>
<div class="wrap" id="main"><div class="card mute">Loading...</div></div>

<dialog id="depDlg">
  <h2>Deposit items</h2>
  <p class="mute" style="margin:6px 0 0">Pick the items you want to put on SplitzMarket. Our bot will send you a trade in MM2 to collect them.</p>
  <input id="depSearch" placeholder="Search items" style="width:100%;margin-top:12px">
  <div class="pick" id="pick"></div>
  <div class="row" style="display:flex;justify-content:space-between;align-items:center;gap:10px">
    <span class="mute" id="depCount">0 items selected</span>
    <span><button class="ghost" onclick="depDlg.close()">Cancel</button> <button class="btn" id="depGo">Request deposit</button></span>
  </div>
  <div class="err" id="depErr"></div>
</dialog>
<dialog id="sellDlg">
  <h2>Sell items</h2>
  <p class="mute" style="margin:6px 0 0">Each item starts at its recommended price. Change any of them, or set one price for everything. When someone buys, the money goes straight to your balance.</p>
  <div class="setall"><label class="mute">Set price for all items</label>
    <div class="two"><label class="money"><span>$</span><input id="sellAll" inputmode="decimal" placeholder="0.00" autocomplete="off" aria-label="Price for every item"></label>
      <label class="money"><span>$</span><input id="sellRatio" inputmode="decimal" placeholder="per 1k value" autocomplete="off" aria-label="Dollars per 1,000 value"><em>/ 1k value</em></label></div></div>
  <div class="pick" id="sellList"></div>
  <div class="totals">
    <div class="sumline"><span class="mute">Total price</span><span id="sellTotal">$0.00</span></div>
    <div class="sumline"><span class="mute" id="sellFeeL">Marketplace fee (0%)</span><span id="sellFee">$0.00</span></div>
    <div class="sumline big"><span>You will receive</span><span id="sellGet">$0.00</span></div>
  </div>
  <div class="err" id="sellErr"></div>
  <div style="display:flex;justify-content:flex-end;gap:8px"><button class="ghost" onclick="sellDlg.close()">Cancel</button> <button class="btn" id="sellGo">List for sale</button></div>
</dialog>
<div id="toast" role="status"></div>

<script src="/auth.js"></script>
<script>
const $ = (id) => document.getElementById(id);
const el = (t, p = {}, ...k) => { const e = document.createElement(t); for (const [a, v] of Object.entries(p)) { if (a.includes('-')) e.setAttribute(a, v); else e[a] = v; } k.forEach((x) => x != null && e.append(x)); return e; };
const toast = (t, bad) => { const x = $('toast'); x.textContent = t; x.style.background = bad ? 'var(--bad)' : ''; x.classList.add('show'); setTimeout(() => x.classList.remove('show'), 2200); };
const when = (d) => new Date(d).toLocaleString([], { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
async function api(url, method = 'GET', body) {
  const r = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: body ? JSON.stringify(body) : undefined });
  const d = await r.json().catch(() => ({}));
  if (!r.ok) throw new Error(d.error || 'Something went wrong');
  return d;
}
const RC = { Chroma: '#b78bff', Ancient: '#7c5cff', Godly: '#d94fd0', Unique: '#e6b422', Vintage: '#d9b98a', Legendary: '#ff4d4d', Rare: '#2fb36a', Uncommon: '#4d7cff', Common: '#8a8fa3' };
const ICON = {
  Knife: '<svg viewBox="0 0 64 64"><path d="M14 54 40 10l8 5-24 42z" fill="currentColor"/></svg>',
  Gun: '<svg viewBox="0 0 64 64"><path d="M6 22h42v11H31l-4 17H15l3-17H6z" fill="currentColor"/></svg>',
  Pet: '<svg viewBox="0 0 64 64"><circle cx="32" cy="38" r="16" fill="currentColor"/><circle cx="19" cy="17" r="7" fill="currentColor"/><circle cx="45" cy="17" r="7" fill="currentColor"/></svg>',
  Misc: '<svg viewBox="0 0 64 64"><path d="m32 6 8 18h19L44 36l5 20-17-11-17 11 5-20L5 24h19z" fill="currentColor"/></svg>'
};
function art(i) {
  const a = el('div', { className: 'art' });
  a.style.setProperty('--c', RC[i.rarity] || RC.Common);
  if (i.image_url && /^(https:\/\/|\/img\/item\/|\/items\/)/.test(i.image_url)) a.append(el('img', { src: i.image_url, alt: '', loading: 'lazy', referrerPolicy: 'no-referrer', onerror: (e) => { e.target.remove(); a.insertAdjacentHTML('beforeend', ICON[i.type] || ICON.Misc); } }));
  else a.insertAdjacentHTML('beforeend', ICON[i.type] || ICON.Misc);
  return a;
}

let me = null, info = { open: false, accounts: [] }, catalog = [], inv = [], selected = new Set(), qty = new Map(), timer = null;
const canTrade = () => info.open || (me && me.owner);
const canSell = () => info.market || (me && me.owner);
const usd = (c) => window.money ? window.money(c) : '$' + (c / 100).toFixed(2);

function gate() {
  $('who').replaceChildren(el('button', { className: 'btn sm', textContent: 'Log in with Roblox', onclick: () => RbxAuth.open(() => location.reload()) }));
  $('main').replaceChildren(el('div', { className: 'card gate' }, el('h2', { textContent: 'Log in to see your inventory' }),
    el('p', { className: 'mute', textContent: 'Your inventory is tied to your verified Roblox account.' }),
    el('button', { className: 'btn', textContent: 'Log in with Roblox', onclick: () => RbxAuth.open(() => location.reload()) })));
}

function shell() {
  const depBtn = el('button', { className: 'btn', textContent: 'Deposit items', onclick: () => openItemDeposit() });
  const wdBtn = canTrade() ? el('button', { className: 'ghost', id: 'wdBtn', textContent: 'Withdraw items', onclick: withdraw }) : soonBtn('Withdraw', 'ghost');
  const sellBtn = canSell() ? el('button', { className: 'btn', id: 'sellBtn', textContent: 'Sell selected', disabled: true, onclick: openSell }) : soonBtn('Sell', 'btn');
  depBtn.className = depBtn.className.replace(/\bbtn\b/, 'ghost');
  const notice = [];
  if (!info.open) notice.push(el('div', { className: 'notice' }, el('b', { textContent: 'Withdrawals are paused. ' }),
    me.owner ? 'Only owners can withdraw right now (TRADING_OPEN is set to false).' : 'Your items are safe. Withdrawals are back shortly.'));
  if (info.accounts.length) notice.push(el('div', { className: 'notice' }, el('b', { textContent: 'Only trade with our official accounts: ' }), info.accounts.join(', '),
    '. Anyone else asking you for items is not SplitzMarket.'));
  const search = el('input', { id: 'shopQ', placeholder: 'Item name, rarity, etc...', oninput: () => drawInv() });
  const seg = el('div', { className: 'seg', id: 'seg' }, ...[['all', 'All'], ['listed', 'Listed'], ['unlisted', 'Unlisted']].map(([k, l]) => el('button', { type: 'button', textContent: l, className: shopView === k ? 'on' : '', onclick: () => { shopView = k; [...$('seg').children].forEach((b, n) => b.classList.toggle('on', ['all', 'listed', 'unlisted'][n] === k)); drawInv(); } })));
  const selAll = el('button', { className: 'ghost', type: 'button', id: 'selAll', textContent: 'Select all', onclick: () => {
    const held = visible().filter((i) => i.status === 'held');
    const all = held.length && held.every((i) => selected.has(i.id));
    held.forEach((i) => (all ? selected.delete(i.id) : selected.add(i.id))); drawInv();
  } });
  $('main').replaceChildren(
    el('div', { className: 'shophd' }, window.avEl(me),
      el('div', {}, el('h1', {}, 'My Shop', el('span', { className: 'chip', id: 'cCount' }), el('span', { className: 'chip g', id: 'cValue' })),
        el('a', { className: 'mute', href: '/?seller=' + encodeURIComponent(me.username), textContent: 'View your public shop page →', style: 'color:var(--mute)' })),
      el('div', { className: 'acts' }, depBtn, wdBtn, sellBtn)),
    ...notice,
    el('div', { className: 'sums', id: 'sums' }),
    el('div', { className: 'layout' },
      el('section', { className: 'card' }, el('div', { className: 'stools' }, search, selAll, seg), el('div', { className: 'grid', id: 'grid' })),
      el('aside', {}, el('section', { className: 'card' }, el('h2', { textContent: 'Trade requests' }), el('div', { id: 'trades' })))));
}

// One card per item (per price for listings) with a ×N count instead of duplicate cards.
let shopView = 'all';
function visible() {
  const q = ($('shopQ') ? $('shopQ').value : '').trim().toLowerCase();
  return inv.filter((i) => (shopView === 'all' || (shopView === 'listed' ? i.status === 'listed' : i.status !== 'listed'))
    && (!q || (i.name + ' ' + i.rarity + ' ' + i.type).toLowerCase().includes(q)));
}
function groupsOf(list) {
  const m = new Map();
  for (const i of list) {
    const k = i.status + ':' + i.item_id + (i.status === 'listed' ? ':' + i.price_cents : '');
    if (!m.has(k)) m.set(k, { ...i, units: [] });
    m.get(k).units.push(i);
  }
  const order = { held: 0, listed: 1, withdrawing: 2 };
  return [...m.values()].sort((a, b) => order[a.status] - order[b.status] || b.value - a.value || a.name.localeCompare(b.name));
}
function drawSums() {
  const listed = inv.filter((i) => i.status === 'listed'), held = inv.filter((i) => i.status === 'held');
  const pct = info.sale_tax_pct || 0;
  const gross = listed.reduce((a, i) => a + i.price_cents, 0);
  const get = listed.reduce((a, i) => a + i.price_cents - Math.round(i.price_cents * pct / 100), 0);
  const est = held.reduce((a, i) => a + recCents(i.value), 0);
  $('cCount').textContent = inv.length + ' item' + (inv.length === 1 ? '' : 's') + ' total';
  $('cValue').textContent = '~' + usd(gross + est);
  $('sums').replaceChildren(
    el('div', {}, el('span', { textContent: 'Listed for sale' }), el('b', { textContent: usd(gross) }), el('em', { textContent: listed.length + ' item' + (listed.length === 1 ? '' : 's') })),
    el('div', { className: 'get' }, el('span', { textContent: 'You will get' }), el('b', { textContent: usd(get) }), el('em', { textContent: pct ? 'if everything listed sells, after the ' + pct + '% fee' : 'if everything listed sells' })),
    el('div', {}, el('span', { textContent: 'Not listed' }), el('b', { textContent: '~' + usd(est) }), el('em', { textContent: held.length + ' item' + (held.length === 1 ? '' : 's') + ' at recommended prices' })),
    el('div', {}, el('span', { textContent: 'Total value' }), el('b', { textContent: inv.reduce((a, i) => a + (i.value || 0), 0).toLocaleString() }), el('em', { textContent: 'MM2 value of everything here' })));
}
function drawInv() {
  const g = $('grid'); g.replaceChildren();
  const held = inv.filter((i) => i.status === 'held');
  for (const id of [...selected]) if (!held.some((i) => i.id === id)) selected.delete(id);
  drawSums();
  const list = visible();
  if (!inv.length) g.append(el('div', { className: 'empty', style: 'grid-column:1/-1', textContent: 'Nothing here yet. Deposit items to see them here.' }));
  else if (!list.length) g.append(el('div', { className: 'empty', style: 'grid-column:1/-1', textContent: 'No items match.' }));
  for (const x of groupsOf(list)) {
    const n = x.units.length;
    const t = el('div', { className: 'tag', textContent: x.status === 'withdrawing' ? 'WITHDRAWING' : x.status === 'listed' ? 'LISTED' : x.rarity.toUpperCase() });
    t.style.setProperty('--c', x.status === 'listed' ? 'var(--gold)' : RC[x.rarity] || RC.Common);
    const pic = art(x); pic.style.position = 'relative';
    if (n > 1) pic.append(el('span', { className: 'qty', textContent: n + 'x' }));
    const meta = el('span', { className: 'mute', textContent: x.type + ', ' + x.rarity + (x.value ? ' · value ' + x.value.toLocaleString() : '') });
    if (x.status === 'listed') {
      const down = el('button', { className: 'ghost down', type: 'button', textContent: n > 1 ? 'Take down all ' + n : 'Take down', onclick: async () => {
        down.disabled = true;
        try { for (const u of x.units) await api('/api/market/' + u.listing_id + '/cancel', 'POST'); toast(n > 1 ? n + ' listings taken down' : 'Listing taken down'); }
        catch (e) { toast(e.message, true); }
        refresh();
      } });
      const lc = el('div', { className: 'it listed' }, pic, t,
        el('div', { className: 'info' }, el('b', { textContent: x.name }),
          el('span', { className: 'price', textContent: usd(x.price_cents * n) }),
          n > 1 ? el('span', { className: 'each', textContent: usd(x.price_cents) + ' each · ' }) : null, meta), down);
      if (window.valueTip) valueTip(lc.querySelector('.art'), x);
      g.append(lc);
      continue;
    }
    const busy = x.status !== 'held';
    const pickedN = x.units.filter((u) => selected.has(u.id)).length;
    const card = el('div', { className: 'it' + (pickedN ? ' sel' : '') + (busy ? ' busy' : ''), role: 'button', tabIndex: busy ? -1 : 0 },
      pic, t, busy ? null : el('span', { className: 'tick', textContent: pickedN ? '✓' : '' }),
      el('div', { className: 'info' }, el('b', { textContent: x.name }), meta));
    if (!busy && n > 1 && pickedN) {
      const setN = (k) => { x.units.forEach((u, j) => (j < k ? selected.add(u.id) : selected.delete(u.id))); drawInv(); };
      card.append(el('div', { className: 'stp', onclick: (e) => e.stopPropagation() },
        el('span', { textContent: '−', onclick: () => setN(pickedN - 1) }), el('em', { textContent: pickedN + ' / ' + n + ' selected' }), el('span', { textContent: '+', onclick: () => setN(Math.min(n, pickedN + 1)) })));
    }
    if (!busy && (canTrade() || canSell())) {
      const toggle = () => { x.units.forEach((u) => (pickedN ? selected.delete(u.id) : selected.add(u.id))); drawInv(); };
      card.onclick = toggle; card.onkeydown = (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); } };
    }
    if (window.valueTip) valueTip(card, x);
    g.append(card);
  }
  const sa = $('selAll'); if (sa) { const h = list.filter((i) => i.status === 'held'); sa.textContent = h.length && h.every((i) => selected.has(i.id)) ? 'Clear selection' : 'Select all'; sa.disabled = !h.length; }
  const w = $('wdBtn'); if (w) { w.textContent = selected.size ? 'Withdraw ' + selected.size + ' item' + (selected.size === 1 ? '' : 's') : 'Withdraw items'; }
  const sb = $('sellBtn'); if (sb) { sb.disabled = !selected.size; sb.textContent = selected.size ? 'Sell ' + selected.size : 'Sell selected'; }
}

function drawTrades(rows) {
  const box = $('trades'); box.replaceChildren();
  if (!rows.length) box.append(el('p', { className: 'mute', textContent: 'No requests yet.' }));
  const label = { pending: 'Waiting', in_progress: 'In progress', completed: 'Done', failed: 'Failed', cancelled: 'Cancelled' };
  rows.slice(0, 12).forEach((t) => {
    const active = t.status === 'pending' || t.status === 'in_progress';
    const names = t.items.map((x) => (x.qty > 1 ? x.qty + '× ' : '') + x.name).join(', ');
    const card = el('div', { className: 'tr' },
      el('div', { className: 'row' }, el('b', { textContent: (t.kind === 'deposit' ? 'Deposit' : 'Withdraw') + ' #' + t.id }), el('span', { className: 'pill ' + t.status, textContent: label[t.status] || t.status })),
      el('div', { className: 'mute', style: 'margin-top:4px;overflow-wrap:anywhere', textContent: names }));
    if (active) {
      card.append(el('div', { className: 'botnote' }, el('span', { className: 'live' }), t.status === 'in_progress' ? 'The bot is trading you now. Accept it in MM2.' : 'Join the bot\'s private server and it will trade you.'),
        el('button', { className: 'btn sm', style: 'margin-top:8px', textContent: 'Join bot', onclick: () => openItemDeposit(t.kind === 'withdraw' ? 'receive' : '') }));
      if (t.status === 'pending') card.append(el('button', { className: 'ghost sm', style: 'margin-top:8px', textContent: 'Cancel request', onclick: async () => {
        try { await api('/api/trades/' + t.id + '/cancel', 'POST'); toast('Request cancelled'); refresh(); } catch (e) { toast(e.message, true); }
      } }));
    } else {
      card.append(el('div', { className: 'mute', style: 'margin-top:6px', textContent: when(t.updated_at) + (t.note ? ' · ' + t.note : '') }));
    }
    box.append(card);
  });
}

async function refresh() {
  const [i, t] = await Promise.all([api('/api/inventory'), api('/api/trades')]);
  inv = i; drawInv(); drawTrades(t);
}

function drawPick() {
  const q = $('depSearch').value.toLowerCase();
  const box = $('pick'); box.replaceChildren();
  const rows = catalog.filter((c) => c.name.toLowerCase().includes(q)).slice(0, 80);
  if (!catalog.length) box.append(el('p', { className: 'mute', textContent: 'The item list is empty. Owners add items in the owner panel.' }));
  rows.forEach((c) => {
    const n = qty.get(c.id) || 0;
    const out = el('output', { textContent: n });
    const set = (v) => { v = Math.max(0, Math.min(50, v)); v ? qty.set(c.id, v) : qty.delete(c.id); out.textContent = v; count(); };
    box.append(el('div', { className: 'pr' }, el('span', {}, c.name + ' ', el('small', { textContent: c.rarity + ' ' + c.type })),
      el('div', { className: 'qty' }, el('button', { type: 'button', textContent: '−', 'aria-label': 'Less ' + c.name, onclick: () => set((qty.get(c.id) || 0) - 1) }), out,
        el('button', { type: 'button', textContent: '+', 'aria-label': 'More ' + c.name, onclick: () => set((qty.get(c.id) || 0) + 1) }))));
  });
}
function count() { const n = [...qty.values()].reduce((a, b) => a + b, 0); $('depCount').textContent = n + ' item' + (n === 1 ? '' : 's') + ' selected'; }
async function openDeposit() {
  if (!catalog.length) catalog = await api('/api/items');
  qty.clear(); $('depSearch').value = ''; $('depErr').textContent = ''; drawPick(); count(); depDlg.showModal(); $('depSearch').focus();
}
$('depSearch').oninput = drawPick;
$('depGo').onclick = async () => {
  const items = [...qty.entries()].map(([item_id, q]) => ({ item_id, qty: q }));
  $('depErr').textContent = ''; $('depGo').disabled = true;
  try { await api('/api/trades/deposit', 'POST', { items }); depDlg.close(); toast('Deposit requested. Our bot will send you a trade.'); refresh(); }
  catch (e) { $('depErr').textContent = e.message; }
  $('depGo').disabled = false;
};
// Recommended price: RECOMMENDED_PER_1K dollars per 1,000 value (default $20).
const recCents = (v) => Math.round((v || 0) * (info.rec_per_1k ?? 20) / 10);
const toC = (v) => { const t = String(v || '').trim().replace(/^\$/, ''); return /^\d+(\.\d{1,2})?$/.test(t) ? Math.round(parseFloat(t) * 100) : 0; };
let sellRows = [];
// Slider position 0..100 maps to 50%..200% of the recommended price (100% in the middle).
const posToPrice = (rec, p) => Math.max(5, Math.round(rec * Math.pow(2, (p - 50) / 50)));
const priceToPos = (rec, c) => (rec ? Math.max(0, Math.min(100, 50 + 50 * Math.log2(c / rec))) : 50);
function dealOf(c, rec) {
  if (!c || !rec) return ['', rec ? 'Set a price' : 'No value yet'];
  const r = c / rec;
  return r <= 0.7 ? ['steal', 'Steal'] : r <= 0.92 ? ['good', 'Good deal'] : r <= 1.1 ? ['fair', 'Fair price'] : r <= 1.4 ? ['pricey', 'Pricey'] : ['over', 'Overpriced'];
}
function sellTotal(skip) {
  let t = 0;
  let fee = 0; const pct = info.sale_tax_pct || 0;
  sellRows.forEach((r) => {
    const c = toC(r.input.value); t += c * r.ids.length; fee += Math.round(c * pct / 100) * r.ids.length;
    if (r.slider !== skip && r.rec && c) r.slider.value = priceToPos(r.rec, c);
    const [cls, label] = dealOf(c, r.rec);
    r.tag.className = 'deal ' + cls; r.tag.textContent = label;
  });
  $('sellTotal').textContent = usd(t); $('sellFeeL').textContent = 'Marketplace fee (' + pct + '%)'; $('sellFee').textContent = (fee ? '−' : '') + usd(fee); $('sellGet').textContent = usd(t - fee);
}
function openSell() {
  const box = $('sellList'); box.replaceChildren(); sellRows = [];
  $('sellAll').value = ''; $('sellRatio').value = '';
  const picked = new Map();
  inv.filter((i) => selected.has(i.id)).forEach((i) => { if (!picked.has(i.item_id)) picked.set(i.item_id, { ...i, ids: [] }); picked.get(i.item_id).ids.push(i.id); });
  [...picked.values()].forEach((i) => {
    const rec = recCents(i.value);
    const input = el('input', { inputMode: 'decimal', placeholder: '0.00', value: rec ? (rec / 100).toFixed(2) : '', 'aria-label': 'Price for ' + i.name });
    input.oninput = () => sellTotal();
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') $('sellGo').click(); });
    const ph = el('div', { className: 'ph' });
    if (i.image_url && /^(https:\/\/|\/img\/item\/|\/items\/)/.test(i.image_url)) ph.append(el('img', { src: i.image_url, alt: '', referrerPolicy: 'no-referrer' })); else { ph.innerHTML = ICON[i.type] || ICON.Misc; ph.style.color = RC[i.rarity] || RC.Common; }
    const slider = el('input', { type: 'range', min: 0, max: 100, step: 1, value: 50, disabled: !rec, 'aria-label': 'Price slider for ' + i.name });
    const tag = el('span', { className: 'deal' });
    slider.oninput = () => { input.value = (posToPrice(rec, +slider.value) / 100).toFixed(2); sellTotal(slider); };
    const recBtn = rec ? el('button', { type: 'button', textContent: '✓ Recommended: ' + usd(rec), title: 'Use the recommended price', onclick: () => { input.value = (rec / 100).toFixed(2); sellTotal(); } }) : el('span', { className: 'mute', textContent: 'No value yet', style: 'font-size:12px' });
    box.append(el('div', { className: 'sitem' },
      el('div', { className: 'top' }, ph, el('div', { className: 'nm' }, el('b', {}, i.name + (i.ids.length > 1 ? ' ×' + i.ids.length : ''), el('small', { textContent: i.rarity + ' ' + i.type + (i.value ? ' · value ' + i.value.toLocaleString() : '') })), recBtn),
        el('label', { className: 'money', title: i.ids.length > 1 ? 'Price for each one' : '' }, el('span', { textContent: '$' }), input, i.ids.length > 1 ? el('em', { textContent: 'each' }) : null)),
      el('div', { className: 'guide' }, slider, tag)));
    sellRows.push({ ids: i.ids, value: i.value, rec, input, slider, tag });
  });
  $('sellErr').textContent = ''; sellTotal(); sellDlg.showModal();
}
$('sellAll').oninput = () => { const c = toC($('sellAll').value); if (!c) return; $('sellRatio').value = ''; sellRows.forEach((r) => (r.input.value = (c / 100).toFixed(2))); sellTotal(); };
$('sellRatio').oninput = () => {
  const d = parseFloat($('sellRatio').value); if (!(d > 0)) return; $('sellAll').value = '';
  sellRows.forEach((r) => { const c = Math.max(5, Math.round((r.value || 0) * d / 10)); r.input.value = (c / 100).toFixed(2); });
  sellTotal();
};
$('sellGo').onclick = async () => {
  $('sellErr').textContent = '';
  const bad = sellRows.find((r) => toC(r.input.value) < 5);
  if (bad) { $('sellErr').textContent = 'Every item needs a price of at least $0.05.'; bad.input.focus(); return; }
  $('sellGo').disabled = true;
  try {
    const r = await api('/api/market/list', 'POST', { items: sellRows.flatMap((x) => x.ids.map((id) => ({ inventory_id: id, price: x.input.value }))) });
    sellDlg.close(); selected.clear(); toast('Listed ' + r.listed + ' item' + (r.listed === 1 ? '' : 's') + ' on the market'); refresh();
  } catch (e) { $('sellErr').textContent = e.message; }
  $('sellGo').disabled = false;
};
function withdraw() { openItemWithdraw([...selected]); }
window.onItemsChanged = () => { selected.clear(); refresh(); };

async function init() {
  me = await api('/api/me').catch(() => null);
  if (!me) return gate();
  $('who').replaceChildren(RbxAuth.menu(me, async () => { await api('/api/logout', 'POST'); location.href = '/'; }));
  info = await api('/api/trading-info').catch(() => info);
  shell();
  await refresh();
  timer = setInterval(() => { if (!document.querySelector('dialog[open]')) refresh().catch(() => {}); }, 8000);
}
init();
</script>
