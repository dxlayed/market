<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SplitzMarket | Buy and sell MM2 items</title>
<meta name="description" content="Buy and sell Murder Mystery 2 items. Every item is held by SplitzMarket and delivered in game by our official trade accounts.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;700;800&family=Manrope:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#0a0707;--surface:#140c0c;--raise:#1e1111;--line:#3a1717;--text:#f6efee;--mute:#a88a88;--gold:#e8202a;--violet:#8f0d14;--ok:#4ade80;--bad:#ff7a45}
*{box-sizing:border-box}
body{margin:0;font-family:Manrope,system-ui,sans-serif;color:var(--text);background:radial-gradient(ellipse 90% 60% at 50% -10%,#3a0a0d 0%,transparent 60%) fixed,var(--bg)}
h1,h2,h3,.logo{font-family:Outfit,system-ui,sans-serif;margin:0}
button,input,select{font:inherit;color:var(--text);background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:9px 12px}
button{cursor:pointer;font-weight:700}
button:disabled{opacity:.55;cursor:not-allowed}
button:focus-visible,input:focus,select:focus,a:focus-visible{outline:2px solid var(--gold);outline-offset:1px}
.btn{background:var(--gold);color:#fff;border:0;transition:filter .15s,box-shadow .15s}.btn:hover:not(:disabled){filter:brightness(1.12);box-shadow:0 0 20px #e8202a55}
a.btn{display:inline-block;text-decoration:none;padding:10px 16px;border-radius:10px;font-weight:700}
.ghost{background:transparent}.sm{padding:6px 12px;font-size:13px;border-radius:8px}
.mute{color:var(--mute);font-size:13px}
::selection{background:#e8202a;color:#fff}
::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-thumb{background:#3a1717;border-radius:99px}

.bar{display:flex;align-items:center;gap:14px;padding:12px 24px;border-bottom:1px solid var(--line);flex-wrap:wrap;background:#0a0707cc;backdrop-filter:blur(8px);position:sticky;top:0;z-index:15}
.logo{font-size:22px;font-weight:800;text-decoration:none;color:var(--text)}.logo b{color:var(--gold);text-shadow:0 0 18px #e8202a88}
.bar nav{display:flex;gap:6px;margin-right:auto}
.bar nav a{padding:8px 14px;border-radius:10px;color:var(--mute);text-decoration:none;font-weight:700}
.bar nav a.on{background:var(--surface);color:var(--text);box-shadow:inset 0 -2px 0 var(--gold)}
.av{width:32px;height:32px;border-radius:9px;background:var(--violet);display:grid;place-items:center;font-weight:800;font-family:Outfit,sans-serif;flex:none}

.layout{display:grid;grid-template-columns:230px minmax(0,1fr) 300px;gap:20px;padding:20px 24px;max-width:1600px;margin:0 auto;align-items:start}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px}
:root{--stick:78px}
.side{position:sticky;top:var(--stick)}
.panel h3{font-size:17px;display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.panel h4{margin:16px 0 8px;font-size:12px;color:var(--mute);letter-spacing:.06em;text-transform:uppercase}
.fhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.fhead h3{margin:0}
.fsec{margin-top:18px}
.fsec h4{margin:0 0 9px;font-size:13px;color:var(--mute);font-weight:700;display:flex;justify-content:space-between;align-items:baseline}
.fsec h4 small{font-weight:600;font-size:12px;color:#7d6261}
#reset{display:inline-flex;align-items:center;gap:6px;color:#ff8a8f;border-color:#e8202a55;background:#e8202a12}
#reset:hover{background:#e8202a26}
#reset svg{width:13px;height:13px}
.game{display:flex;align-items:center;gap:11px;width:100%;text-align:left;padding:11px 12px;border-radius:12px;margin-bottom:8px;background:var(--raise);border:1px solid var(--line);cursor:default}
.game.on{border-color:var(--gold);background:linear-gradient(100deg,#e8202a26,var(--raise) 70%)}
.game.off{opacity:.45}
.game .gi{width:32px;height:32px;border-radius:9px;background:#0a0707;display:grid;place-items:center;flex:none;color:var(--text)}
.game .gi svg{width:20px;height:20px}
.game .gi img{width:30px;height:30px;object-fit:contain;transform:rotate(-8deg)}
.game b{display:block;font-size:13.5px;line-height:1.25}
.game small{display:flex;align-items:center;gap:5px;font-size:12px;font-weight:700;color:var(--mute)}
.game.on small{color:#ff8a8f}
.game .gdot{margin-left:auto;width:9px;height:9px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px #e8202a33}
.prices{display:flex;align-items:center;gap:8px}
.prices label{flex:1;display:flex;align-items:center;background:var(--raise);border:1px solid var(--line);border-radius:10px;padding:0 10px}
.prices label:focus-within{outline:2px solid var(--gold);outline-offset:1px}
.prices label span{color:var(--mute);font-weight:700}
.prices input{border:0;background:transparent;padding:9px 4px;width:100%;min-width:0;font-weight:700}
.prices input:focus{outline:0}
.slider{position:relative;height:28px;margin:8px 4px 0}
.slider .rail{position:absolute;left:0;right:0;top:12px;height:4px;border-radius:99px;background:#2a1414}
.slider .fill{position:absolute;top:12px;height:4px;border-radius:99px;background:var(--gold);box-shadow:0 0 10px #e8202a88}
.slider input{position:absolute;inset:0;width:100%;margin:0;padding:0;background:none;border:0;pointer-events:none;-webkit-appearance:none;appearance:none;height:28px}
.slider input::-webkit-slider-thumb{-webkit-appearance:none;pointer-events:auto;width:16px;height:16px;border-radius:5px;background:#fff;border:3px solid var(--gold);cursor:grab;transform:rotate(45deg)}
.slider input::-moz-range-thumb{pointer-events:auto;width:12px;height:12px;border-radius:4px;background:#fff;border:3px solid var(--gold);cursor:grab;transform:rotate(45deg)}
.slider input:focus{outline:0}
.slider input:focus-visible::-webkit-slider-thumb{box-shadow:0 0 0 4px #e8202a88}
.rlist{display:grid;gap:2px}
.rrow{display:flex;align-items:center;gap:11px;width:100%;text-align:left;background:transparent;border:0;border-left:3px solid transparent;border-radius:0 9px 9px 0;padding:7px 9px;font-weight:700;font-size:14px;color:var(--text)}
.rrow:hover{background:var(--raise)}
.rrow.on{background:linear-gradient(90deg,color-mix(in srgb,var(--c) 22%,transparent),transparent);border-left-color:var(--c)}
.rrow.zero{color:#6e5554}
.rrow i{margin-left:auto;font-style:normal;font-size:12px;color:var(--mute);font-weight:700}
.dot{width:11px;height:11px;border-radius:50%;background:var(--c);box-shadow:0 0 8px var(--c);flex:none}
.dot.chroma{background:conic-gradient(#ff5a5f,#ffd166,#4fe3d0,#8b6cff,#ff5a5f);box-shadow:0 0 8px #c58bff}
.tiles{display:grid;gap:7px}
.tile{position:relative;display:flex;align-items:center;justify-content:space-between;width:100%;height:50px;overflow:hidden;padding:0 12px;border-radius:11px;background:var(--raise);border:1px solid var(--line);text-align:left;color:var(--text)}
.tile:hover{border-color:#5a1f1f}
.tile.on{border-color:var(--gold);background:linear-gradient(100deg,#e8202a2e,var(--raise) 65%)}
.tile b{font-size:14px;z-index:1}
.tile b small{display:block;font-size:11px;color:var(--mute);font-weight:700}
.tile img{width:62px;height:62px;object-fit:contain;transform:translate(10px,2px) rotate(-12deg);flex:none;opacity:.45;filter:grayscale(.6);transition:opacity .15s,filter .15s}
.tile:hover img,.tile.on img{opacity:1;filter:none}

.banner{border-radius:18px;padding:30px;background:radial-gradient(circle at 88% 10%,#e8202a50,transparent 45%),linear-gradient(120deg,#3a0a0d,#120707 70%);border:1px solid var(--line);display:flex;gap:24px;justify-content:space-between;align-items:center;flex-wrap:wrap}
.banner h1{font-size:clamp(26px,3.6vw,42px);font-weight:800;letter-spacing:-1px;line-height:1.05}
.banner p{color:#d9c3c2;margin:10px 0 18px;max-width:520px}
.banner .acts{display:flex;gap:10px;flex-wrap:wrap}
.steps{display:grid;gap:8px;min-width:240px}
.steps div{display:flex;gap:10px;align-items:center;background:#0006;border:1px solid #ffffff10;border-radius:12px;padding:9px 12px;font-size:14px;font-weight:700}
.steps i{font-style:normal;width:24px;height:24px;border-radius:7px;background:var(--gold);display:grid;place-items:center;font-size:12px;flex:none}

.ticker{margin:14px 0;overflow:hidden;border:1px solid var(--line);border-radius:12px;background:var(--surface);display:flex;align-items:center}
.live{position:relative;z-index:1;background:#0f2a18;color:#4ade80;font-weight:800;font-size:12px;padding:6px 12px;margin:6px;border-radius:99px;flex:none;box-shadow:8px 0 12px 4px var(--surface)}
.track{display:flex;gap:28px;white-space:nowrap;animation:slide 45s linear infinite;padding:10px 0;font-size:14px;font-weight:700}
.track em{font-style:normal;color:#4ade80;margin-left:6px}
@keyframes slide{to{transform:translateX(-50%)}}
@media (prefers-reduced-motion:reduce){.track{animation:none}}

.tools{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;align-items:center}.tools input{flex:1;min-width:180px}
.tools{position:sticky;top:calc(var(--stick) - 10px);z-index:12;background:var(--bg);padding:10px 0 8px;margin:-10px 0 6px;box-shadow:0 10px 18px -12px #000}
.views{display:flex;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:3px;gap:3px}
.views button{border:0;background:transparent;color:var(--mute);padding:7px 14px;border-radius:9px;font-size:14px}
.views button.on{background:var(--gold);color:#fff}
.card.unlisted .art{filter:saturate(.75)}
.card.unlisted .price{color:#b89b9a}
.rec{font-size:12px;font-weight:700;color:var(--mute);display:flex;align-items:center;gap:6px}
.rec b{color:#4ade80;font-weight:800}
.price.est{font-size:21px}
.lc{position:absolute;bottom:10px;left:10px;font-size:11px;font-weight:800;padding:2px 8px;border-radius:99px;background:#4ade8026;color:#4ade80}
.lc.off{background:#000b;color:var(--mute)}
.notice{background:#e8202a14;border:1px solid #e8202a55;border-radius:12px;padding:12px 16px;margin-bottom:14px;font-size:14px}
.notice b{color:var(--gold)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;overflow:hidden;display:flex;flex-direction:column;transition:border-color .15s,transform .15s}
.card:hover{border-color:#6a2222;transform:translateY(-2px)}
.art{height:140px;display:grid;place-items:center;position:relative;background:radial-gradient(circle at 50% 58%,color-mix(in srgb,var(--c) 42%,transparent),transparent 68%),var(--raise);color:var(--c)}
.art svg{width:66px;height:66px;filter:drop-shadow(0 4px 14px color-mix(in srgb,var(--c) 60%,transparent))}
.art img{max-width:78%;max-height:110px}
.badge{position:absolute;top:10px;left:10px;font-size:10px;font-weight:800;padding:2px 8px;border-radius:6px;background:#000a;border:1px solid var(--c);color:#fff;letter-spacing:.04em}
.qty{position:absolute;top:10px;right:10px;font-size:11px;font-weight:800;padding:2px 8px;border-radius:6px;background:#000a;color:var(--text)}
.info{padding:12px;display:flex;flex-direction:column;gap:4px;flex:1}
.info h3{font-size:17px;line-height:1.2}
.price{font-family:Outfit,sans-serif;font-size:24px;font-weight:800;margin-top:6px}
.acts{margin-top:auto;padding-top:8px;display:flex;gap:6px}.acts>*{flex:1}
.empty{grid-column:1/-1;text-align:center;padding:56px 16px;border:1px dashed var(--line);border-radius:14px;color:var(--mute)}

.cart{position:sticky;top:var(--stick);display:flex;flex-direction:column;min-height:380px}
.lines{flex:1;display:flex;flex-direction:column;gap:8px;overflow-y:auto;max-height:46vh}
.none{margin:auto;text-align:center;color:var(--mute);font-size:14px;padding:36px 0}
.line{display:flex;align-items:center;gap:8px;background:var(--raise);border-radius:10px;padding:8px 10px;font-size:14px;font-weight:700}
.line .n{flex:1;overflow-wrap:anywhere}.line .n small{display:block;color:var(--mute);font-weight:500;font-size:12px}
.line button{padding:2px 8px;background:transparent;border:0;color:var(--mute);font-size:18px}
.foot{border-top:1px solid var(--line);margin-top:12px;padding-top:12px;display:grid;gap:6px}
.sum{display:flex;justify-content:space-between;font-size:14px}.sum.big{font-size:18px;font-weight:800;font-family:Outfit,sans-serif}
.sum .short{color:var(--bad)}
.foot .btn{padding:12px;font-size:15px;margin-top:6px}
.err{color:var(--bad);font-size:13px;min-height:16px}
#toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#4ade80;color:#06240f;padding:10px 18px;border-radius:10px;font-weight:700;opacity:0;pointer-events:none;transition:opacity .2s;z-index:40}
#toast.show{opacity:1}
@media (max-width:1150px){.layout{grid-template-columns:1fr}.side,.cart{position:static}.cart{min-height:0}}
</style>
</head>
<body>
<div class="bar">
  <a class="logo" href="/">Splitz<b>Market</b></a>
  <nav><a class="on" href="/">Market</a><a href="/inventory.html">Inventory</a><a href="/support.html">Support</a></nav>
  <div id="who"></div>
</div>

<div class="layout">
  <aside class="panel side">
    <div class="fhead"><h3>Filters</h3><button class="sm" id="reset" type="button"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8a5 5 0 1 1-1.6-3.7M13 2.5V5h-2.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Reset</button></div>
    <div class="fsec"><h4>Game</h4>
      <div class="game on" aria-current="true"><span class="gi"><img src="/items/laser.webp" alt="" width="30" height="30"></span>
        <span><b>Murder Mystery 2</b><small><svg width="11" height="11" viewBox="0 0 16 16" aria-hidden="true"><path d="M9 1 3 9h4l-1 6 6-8H8z" fill="currentColor"/></svg>Instant</small></span><span class="gdot" aria-hidden="true"></span></div>
      <div class="game off" aria-disabled="true"><span class="gi"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="11" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 10.5v4M6 12.5h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="16" cy="11.5" r="1.2" fill="currentColor"/><circle cx="17.5" cy="14" r="1.2" fill="currentColor"/></svg></span>
        <span><b>More games</b><small>On the way</small></span></div>
    </div>
    <div class="fsec"><h4>Price <small id="pnote"></small></h4>
      <div class="prices"><label><span>$</span><input id="pmin" inputmode="decimal" placeholder="0" aria-label="Minimum price"></label><span class="mute">to</span><label><span>$</span><input id="pmax" inputmode="decimal" placeholder="Any" aria-label="Maximum price"></label></div>
      <div class="slider"><div class="rail"></div><div class="fill" id="pfill"></div>
        <input type="range" id="rmin" min="0" max="1000" value="0" aria-label="Minimum price slider"><input type="range" id="rmax" min="0" max="1000" value="1000" aria-label="Maximum price slider"></div>
    </div>
    <div class="fsec"><h4>Rarity</h4><div class="rlist" id="rars"></div></div>
    <div class="fsec"><h4>Type</h4><div class="tiles" id="types"></div></div>
  </aside>

  <main>
    <section class="banner">
      <div>
        <h1 id="hTitle">Buy and sell MM2 items.</h1>
        <p id="hSub">Every item on SplitzMarket is already held by us, so you get exactly what you pay for. It lands in your inventory the moment you buy, and our bot trades it to you in game.</p>
        <div class="acts"><a class="btn" href="/inventory.html">Sell your items</a><button class="ghost" type="button" onclick="document.getElementById('q').focus()">Browse</button></div>
      </div>
      <div class="steps">
        <div><i>1</i>Add funds to your balance</div>
        <div><i>2</i>Buy, and it's yours instantly</div>
        <div><i>3</i>Withdraw it and our bot sends it in game</div>
      </div>
    </section>
    <div class="ticker"><span class="live">RECENT SALES</span><div class="track" id="track"></div></div>
    <div id="notice"></div>
    <div class="tools">
      <div class="views" role="tablist" aria-label="What to show"><button type="button" role="tab" data-v="listed" class="on">Listings only</button><button type="button" role="tab" data-v="all">All items</button></div>
      <input id="q" placeholder="Search" aria-label="Search items">
      <select id="sort" aria-label="Sort"><option value="value">Highest value</option><option value="high">Price: high to low</option><option value="low">Price: low to high</option><option value="new">Newest listings</option></select>
      <span class="mute" id="count"></span>
    </div>
    <div class="grid" id="grid"></div>
  </main>

  <aside class="panel cart" aria-label="Cart">
    <h3>Cart <span class="mute" id="cartN"></span></h3>
    <div class="lines" id="lines"></div>
    <div class="foot" id="foot"></div>
  </aside>
</div>
<div id="toast" role="status"></div>

<script src="/auth.js"></script>
<script>
const $ = (id) => document.getElementById(id);
const el = (t, p = {}, ...k) => { const e = document.createElement(t); for (const [a, v] of Object.entries(p)) { if (a.includes('-')) e.setAttribute(a, v); else e[a] = v; } k.forEach((x) => x != null && e.append(x)); return e; };
const toast = (t, bad) => { const x = $('toast'); x.textContent = t; x.style.background = bad ? 'var(--bad)' : ''; x.classList.add('show'); clearTimeout(x._t); x._t = setTimeout(() => x.classList.remove('show'), 2600); };
const usd = (c) => window.money ? window.money(c) : '$' + (c / 100).toFixed(2);
async function api(url, method = 'GET', body) {
  const r = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: body ? JSON.stringify(body) : undefined });
  const d = await r.json().catch(() => ({}));
  if (!r.ok) { const e = new Error(d.error || 'Something went wrong'); e.status = r.status; throw e; }
  return d;
}

const RC = { Chroma: '#c58bff', Ancient: '#8a6cff', Godly: '#e05ad8', Unique: '#e6b422', Vintage: '#d9b98a', Legendary: '#ff4d4d', Rare: '#2fb36a', Uncommon: '#4d7cff', Common: '#8a8fa3' };
const ICON = {
  Knife: '<svg viewBox="0 0 64 64"><path d="M14 54 40 10l8 5-24 42z" fill="currentColor"/><rect x="8" y="46" width="16" height="6" rx="2" fill="currentColor" opacity=".55" transform="rotate(-30 16 49)"/></svg>',
  Gun: '<svg viewBox="0 0 64 64"><path d="M6 22h42v11H31l-4 17H15l3-17H6z" fill="currentColor"/></svg>',
  Pet: '<svg viewBox="0 0 64 64"><circle cx="32" cy="38" r="16" fill="currentColor"/><circle cx="19" cy="17" r="7" fill="currentColor"/><circle cx="45" cy="17" r="7" fill="currentColor"/></svg>',
  Misc: '<svg viewBox="0 0 64 64"><path d="m32 6 8 18h19L44 36l5 20-17-11-17 11 5-20L5 24h19z" fill="currentColor"/></svg>'
};
function art(i) {
  const a = el('div', { className: 'art' });
  if (i.image_url && /^(https:\/\/|\/img\/item\/|\/items\/)/.test(i.image_url)) a.append(el('img', { src: i.image_url, alt: '', loading: 'lazy', referrerPolicy: 'no-referrer', onerror: (e) => { e.target.remove(); a.insertAdjacentHTML('beforeend', ICON[i.type] || ICON.Misc); } }));
  else a.insertAdjacentHTML('beforeend', ICON[i.type] || ICON.Misc);
  return a;
}

const seller = new URLSearchParams(location.search).get('seller');
let view = 'listed', catalog = [];
const recCents = (v) => Math.round((v || 0) * (info.rec_per_1k ?? 20) / 10); // dollars per 1k value -> cents
const estText = (v) => (window.estRange ? estRange(recCents(v)) : usd(recCents(v)));
document.querySelectorAll('.views button').forEach((b) => {
  b.classList.toggle('on', b.dataset.v === view);
  b.onclick = () => { view = b.dataset.v; document.querySelectorAll('.views button').forEach((x) => x.classList.toggle('on', x === b)); draw(); };
});
// Every valued item, joined with its live listings (cheapest first).
function allEntries() {
  const by = new Map();
  rows.forEach((l) => { if (!by.has(l.item_id)) by.set(l.item_id, []); by.get(l.item_id).push(l); });
  return catalog.map((i) => {
    const lst = (by.get(i.id) || []).slice().sort((a, b) => a.price_cents - b.price_cents);
    const newest = lst.reduce((a, l) => (l.created_at > a ? l.created_at : a), '');
    return { ...i, item_id: i.id, lst, rec: recCents(i.value), price_cents: lst.length ? lst[0].price_cents : null, shown: lst.length ? lst[0].price_cents : recCents(i.value), newest };
  });
}
function dataset() { return view === 'all' ? allEntries().map((e) => ({ ...e, price_cents: e.shown })) : rows; }
let me = null, info = { market: false }, rows = [], rars = new Set(), cart = [], busy = false;
try { cart = JSON.parse(localStorage.getItem('cart') || '[]').filter(Number.isInteger); } catch {}
const saveCart = () => { try { localStorage.setItem('cart', JSON.stringify(cart)); } catch {} };
const canBuy = () => info.market || (me && me.owner);

const TYPE_PIC = { Knife: '/items/darksword.webp', Gun: '/items/luger.webp' };
const TYPE_SUB = { Knife: 'Blades & scythes', Gun: 'Guns & bows' };
const types = new Set();
let priceTop = 500000; // slider top in cents, set from the most expensive listing
// The slider is curved so low prices get most of the track, where most items are.
const posToCents = (p) => (p >= 1000 ? Infinity : Math.round(priceTop * Math.pow(p / 1000, 2.6)));
const centsToPos = (c) => (c == null || !isFinite(c) ? 1000 : Math.round(1000 * Math.pow(Math.min(1, c / priceTop), 1 / 2.6)));
const toInput = (c) => (c / 100 >= 100 ? String(Math.round(c / 100)) : (c / 100).toFixed(2));
function paintSlider() {
  const a = +$('rmin').value, b = +$('rmax').value;
  $('pfill').style.left = a / 10 + '%'; $('pfill').style.right = (100 - b / 10) + '%';
}
function fromSlider(which) {
  let a = +$('rmin').value, b = +$('rmax').value;
  if (a > b - 10) { if (which === 'min') $('rmin').value = a = b - 10; else $('rmax').value = b = a + 10; }
  $('pmin').value = a <= 0 ? '' : toInput(posToCents(a));
  $('pmax').value = b >= 1000 ? '' : toInput(posToCents(b));
  paintSlider(); draw();
}
function fromInputs() {
  const mn = parseFloat($('pmin').value), mx = parseFloat($('pmax').value);
  $('rmin').value = isNaN(mn) ? 0 : centsToPos(mn * 100);
  $('rmax').value = isNaN(mx) ? 1000 : centsToPos(mx * 100);
  paintSlider(); draw();
}
$('rmin').oninput = () => fromSlider('min'); $('rmax').oninput = () => fromSlider('max');
$('pmin').oninput = fromInputs; $('pmax').oninput = fromInputs;
function buildFacets() {
  $('rars').replaceChildren(...Object.keys(RC).map((r) => {
    const dot = el('span', { className: 'dot' + (r === 'Chroma' ? ' chroma' : '') });
    const b = el('button', { type: 'button', className: 'rrow', 'aria-pressed': 'false', onclick: () => { rars.has(r) ? rars.delete(r) : rars.add(r); draw(); } }, dot, r, el('i'));
    b.dataset.k = r; b.style.setProperty('--c', RC[r]); return b;
  }));
  $('types').replaceChildren(...['Knife', 'Gun'].map((t) => {
    const b = el('button', { type: 'button', className: 'tile', 'aria-pressed': 'false', onclick: () => { types.has(t) ? types.delete(t) : types.add(t); draw(); } },
      el('b', {}, t, el('small', { textContent: TYPE_SUB[t] })));
    b.append(el('img', { src: TYPE_PIC[t], alt: '', loading: 'lazy' })); b.dataset.k = t; return b;
  }));
}
buildFacets();
// Counts next to each rarity and type follow the search and price filters.
function paintFacets() {
  const q = $('q').value.toLowerCase().trim();
  const min = parseFloat($('pmin').value) * 100, max = parseFloat($('pmax').value) * 100;
  const data = dataset();
  const base = data.filter((l) => (!q || l.name.toLowerCase().includes(q)) && (isNaN(min) || l.price_cents >= min) && (isNaN(max) || l.price_cents <= max));
  document.querySelectorAll('#rars .rrow').forEach((b) => {
    const n = base.filter((l) => l.rarity === b.dataset.k && (!types.size || types.has(l.type))).length;
    b.classList.toggle('on', rars.has(b.dataset.k)); b.setAttribute('aria-pressed', String(rars.has(b.dataset.k)));
    b.classList.toggle('zero', !n); b.querySelector('i').textContent = n;
  });
  document.querySelectorAll('#types .tile').forEach((b) => {
    const n = base.filter((l) => l.type === b.dataset.k && (!rars.size || rars.has(l.rarity))).length;
    b.classList.toggle('on', types.has(b.dataset.k)); b.setAttribute('aria-pressed', String(types.has(b.dataset.k)));
    b.querySelector('small').textContent = TYPE_SUB[b.dataset.k] + ' · ' + n;
  });
  const top = data.reduce((a, l) => Math.max(a, l.price_cents || 0), 0);
  const nextTop = Math.max(1000, Math.ceil(top / 1000) * 1000);
  if (nextTop !== priceTop) { priceTop = nextTop; fromInputsQuiet(); }
  $('pnote').textContent = data.length ? 'up to ' + usd(priceTop) : '';
}
function fromInputsQuiet() {
  const mn = parseFloat($('pmin').value), mx = parseFloat($('pmax').value);
  $('rmin').value = isNaN(mn) ? 0 : centsToPos(mn * 100); $('rmax').value = isNaN(mx) ? 1000 : centsToPos(mx * 100); paintSlider();
}
paintSlider();
$('reset').onclick = () => {
  types.clear(); rars.clear(); $('q').value = $('pmin').value = $('pmax').value = '';
  $('rmin').value = 0; $('rmax').value = 1000; paintSlider(); draw();
};
$('q').oninput = draw; $('sort').onchange = draw;

// Identical items from the same seller at the same price show as one card with a count.
function groups() {
  const q = $('q').value.toLowerCase().trim();
  const min = parseFloat($('pmin').value) * 100, max = parseFloat($('pmax').value) * 100;
  const m = new Map();
  rows.filter((l) => (!q || l.name.toLowerCase().includes(q)) && (!types.size || types.has(l.type)) && (!rars.size || rars.has(l.rarity))
    && (isNaN(min) || l.price_cents >= min) && (isNaN(max) || l.price_cents <= max))
    .forEach((l) => {
      const k = l.item_id + ':' + l.seller_id + ':' + l.price_cents;
      if (!m.has(k)) m.set(k, { ...l, ids: [], newest: l.created_at });
      const g = m.get(k); g.ids.push(l.id); if (l.created_at > g.newest) g.newest = l.created_at;
    });
  const s = $('sort').value, list = [...m.values()];
  list.sort((a, b) => s === 'high' ? b.price_cents - a.price_cents : s === 'new' ? (b.newest > a.newest ? 1 : -1) : s === 'value' ? b.value - a.value : a.price_cents - b.price_cents);
  return list;
}

function drawAll() {
  const q = $('q').value.toLowerCase().trim();
  const min = parseFloat($('pmin').value) * 100, max = parseFloat($('pmax').value) * 100;
  const list = allEntries().filter((e) => (!q || e.name.toLowerCase().includes(q)) && (!types.size || types.has(e.type)) && (!rars.size || rars.has(e.rarity))
    && (isNaN(min) || e.shown >= min) && (isNaN(max) || e.shown <= max));
  const s = $('sort').value;
  list.sort((a, b) => s === 'high' ? b.shown - a.shown : s === 'low' ? a.shown - b.shown : s === 'new' ? ((b.newest || '') > (a.newest || '') ? 1 : (b.newest || '') < (a.newest || '') ? -1 : b.value - a.value) : b.value - a.value);
  const g = $('grid'); g.replaceChildren();
  const listed = list.filter((e) => e.lst.length).length;
  $('count').textContent = list.length + ' items · ' + listed + ' listed';
  if (!list.length) g.append(el('div', { className: 'empty', textContent: catalog.length ? 'Nothing matches these filters. Try resetting them.' : 'No items yet.' }));
  list.forEach((x) => {
    const a = art(x);
    a.append(el('span', { className: 'badge', textContent: x.rarity.toUpperCase() }));
    a.append(el('span', { className: 'lc' + (x.lst.length ? '' : ' off'), textContent: x.lst.length ? x.lst.length + ' listed' : 'Not listed' }));
    const acts = el('div', { className: 'acts' });
    if (x.lst.length) {
      const mine = me ? x.lst.filter((l) => l.seller_id === me.id).length : 0;
      const free = x.lst.find((l) => !cart.includes(l.id) && !(me && l.seller_id === me.id));
      const inCart = x.lst.filter((l) => cart.includes(l.id)).length;
      acts.append(el('button', { className: 'btn sm', type: 'button', disabled: !free,
        textContent: !free ? (mine === x.lst.length ? 'Only your listings' : 'All in cart') : inCart ? 'Add another (' + inCart + ')' : 'Add to cart',
        onclick: () => { if (!me) return login(); cart.push(free.id); saveCart(); draw(); drawCart(); } }));
    } else acts.append(el('button', { className: 'btn sm', type: 'button', disabled: true, textContent: 'No listings yet' }));
    const priceRow = x.lst.length
      ? [el('div', { className: 'price', textContent: usd(x.price_cents) }), el('div', { className: 'rec' }, 'Est. ', el('b', { textContent: estText(x.value) }))]
      : [el('div', { className: 'price est', textContent: estText(x.value) }), el('div', { className: 'rec', textContent: 'Estimated price' })];
    const card = el('article', { className: 'card' + (x.lst.length ? '' : ' unlisted') }, a, el('div', { className: 'info' },
      el('h3', { textContent: x.name }),
      el('div', { className: 'mute', textContent: x.type + ' · value ' + x.value.toLocaleString() }),
      ...priceRow, acts));
    card.style.setProperty('--c', RC[x.rarity] || RC.Common);
    if (window.valueTip) valueTip(a, { ...x, price_cents: x.lst.length ? x.price_cents : null, rec_cents: x.rec });
    g.append(card);
  });
}

function draw() {
  paintFacets();
  if (view === 'all') return drawAll();
  const list = groups(), g = $('grid');
  g.replaceChildren();
  const units = list.reduce((a, x) => a + x.ids.length, 0);
  $('count').textContent = units + ' item' + (units === 1 ? '' : 's') + ' for sale';
  if (!list.length) g.append(el('div', { className: 'empty' }, rows.length ? 'Nothing matches these filters. Try resetting them.' : el('span', {}, el('b', { textContent: 'Nothing for sale yet.' }), el('br'), 'Deposit items in your inventory, then list them here for other players to buy.')));
  list.forEach((x) => {
    const c = RC[x.rarity] || RC.Common;
    const a = art(x);
    a.append(el('span', { className: 'badge', textContent: x.rarity.toUpperCase() }));
    if (x.ids.length > 1) a.append(el('span', { className: 'qty', textContent: '×' + x.ids.length }));
    const inCart = x.ids.filter((id) => cart.includes(id)).length;
    const acts = el('div', { className: 'acts' });
    if (me && me.id === x.seller_id) acts.append(el('a', { className: 'btn sm', href: '/inventory.html', textContent: 'Your listing', style: 'text-align:center;background:var(--raise)' }));
    else {
      const free = x.ids.find((id) => !cart.includes(id));
      acts.append(el('button', { className: 'btn sm', type: 'button', disabled: !free, textContent: !free ? 'All in cart' : inCart ? 'Add another (' + inCart + ')' : 'Add to cart',
        onclick: () => { if (!me) return login(); cart.push(free); saveCart(); draw(); drawCart(); } }));
    }
    const card = el('article', { className: 'card' }, a, el('div', { className: 'info' },
      el('h3', { textContent: x.name }),
      el('div', { className: 'mute' }, x.type + ' · value ' + x.value.toLocaleString() + ' · by ', el('a', { href: '/?seller=' + encodeURIComponent(x.seller), textContent: x.seller, style: 'color:inherit' })),
      el('div', { className: 'price', textContent: usd(x.price_cents) }), x.value ? el('div', { className: 'rec' }, 'Est. ', el('b', { textContent: estText(x.value) })) : null, acts));
    card.style.setProperty('--c', c);
    if (window.valueTip) valueTip(a, { ...x, rec_cents: recCents(x.value) });
    g.append(card);
  });
}

function drawCart() {
  const byId = new Map(rows.map((r) => [r.id, r]));
  const before = cart.length;
  cart = cart.filter((id) => byId.has(id) && !(me && byId.get(id).seller_id === me.id));
  if (cart.length !== before) saveCart();
  const lines = $('lines'), foot = $('foot');
  lines.replaceChildren(); foot.replaceChildren();
  $('cartN').textContent = cart.length ? cart.length + ' item' + (cart.length === 1 ? '' : 's') : '';
  if (!cart.length) { lines.append(el('div', { className: 'none' }, el('b', { textContent: 'Your cart is empty' }), el('br'), 'Add items from the market to buy them.')); }
  let total = 0;
  cart.forEach((id) => {
    const l = byId.get(id); total += l.price_cents;
    lines.append(el('div', { className: 'line' }, el('span', { className: 'n' }, l.name, el('small', { textContent: l.rarity + ' · from ' + l.seller })),
      el('span', { textContent: usd(l.price_cents) }),
      el('button', { type: 'button', textContent: '×', 'aria-label': 'Remove ' + l.name, onclick: () => { cart = cart.filter((c) => c !== id); saveCart(); draw(); drawCart(); } })));
  });
  const bal = me ? me.balance : 0, short = total - bal;
  foot.append(el('div', { className: 'sum big' }, el('span', { textContent: 'Total' }), el('span', { textContent: usd(total) })));
  if (me) foot.append(el('div', { className: 'sum mute' }, el('span', { textContent: 'Your balance' }), el('span', { textContent: usd(bal) })));
  const err = el('div', { className: 'err', id: 'buyErr' });
  if (!me) foot.append(el('button', { className: 'btn', type: 'button', textContent: 'Log in to buy', onclick: login }));
  else if (!canBuy()) foot.append(el('button', { className: 'btn', type: 'button', disabled: true, textContent: 'Checkout paused' }));
  else if (cart.length && short > 0) {
    foot.append(el('div', { className: 'sum' }, el('span', { textContent: 'You need' }), el('span', { className: 'short', textContent: usd(short) + ' more' })),
      el('button', { className: 'btn', type: 'button', textContent: 'Add funds', onclick: () => openFunds('add') }));
  } else foot.append(el('button', { className: 'btn', type: 'button', disabled: !cart.length || busy, textContent: busy ? 'Buying...' : 'Buy now', onclick: buy }));
  foot.append(err);
}

async function buy() {
  busy = true; drawCart();
  try {
    const r = await api('/api/market/buy', 'POST', { listing_ids: cart });
    cart = []; saveCart(); me.balance = r.balance; setBalance(r.balance);
    toast('Bought ' + r.bought + ' item' + (r.bought === 1 ? '' : 's') + '. They are in your inventory now.');
    busy = false; await load();
    const send = el('button', { className: 'btn', type: 'button', textContent: 'Withdraw now', onclick: () => openItemWithdraw(r.inventory_ids) });
    $('lines').replaceChildren(el('div', { className: 'none' }, el('b', { textContent: 'Purchase complete' }), el('br'), 'Your items are in your inventory. Withdraw them now, join our bot\'s server and it trades them to you in MM2. Or keep them to sell later.', el('br'), el('br'),
      info.open || me.owner ? send : null, ' ', el('a', { className: 'ghost sm', href: '/inventory.html', textContent: 'Go to inventory', style: 'color:var(--text)' })));
  } catch (e) {
    busy = false;
    if (e.status === 409) await load();
    else drawCart();
    $('buyErr').textContent = e.message;
  }
}

function login() { RbxAuth.open((u) => location.reload()); }
function drawWho() {
  const w = $('who'); w.replaceChildren();
  if (me) w.append(RbxAuth.menu(me, async () => { await api('/api/logout', 'POST'); me = null; drawWho(); drawCart(); draw(); }));
  else w.append(el('button', { className: 'btn sm', type: 'button', textContent: 'Log in with Roblox', onclick: login }));
}
function drawNotice() {
  const n = $('notice'); n.replaceChildren();
  if (!info.market) n.append(el('div', { className: 'notice' }, el('b', { textContent: 'Checkout is paused. ' }),
    me && me.owner ? 'Only owners can buy and sell right now (LISTINGS_OPEN is set to false).' : 'You can browse what is for sale. Buying is back shortly.'));
}

async function load() {
  const [r, c] = await Promise.all([api('/api/market' + (seller ? '?seller=' + encodeURIComponent(seller) : '')).catch(() => null), api('/api/values').catch(() => null)]);
  if (r) rows = r; if (c) catalog = c;
  if (me) { const u = await refreshBalance(); if (u) me.balance = u.balance; }
  draw(); drawCart();
}
async function loadSales() {
  try {
    const s = await api('/api/market/recent');
    const t = s.map((x) => '<span>' + esc(x.name) + '<em>' + usd(x.price_cents) + '</em></span>').join('');
    $('track').innerHTML = s.length ? t + t : '<span class="mute">Sales will show up here as they happen</span>';
  } catch {}
}
const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

{ const qp = new URLSearchParams(location.search).get('q'); if (qp) $('q').value = qp.slice(0, 50); }
if (seller) { $('hTitle').textContent = seller + "'s shop"; $('hSub').textContent = 'Everything this player has for sale right now. Every item is held by SplitzMarket until you buy it.'; }
(async () => {
  [me, info] = await Promise.all([api('/api/me').catch(() => null), api('/api/trading-info').catch(() => info)]);
  drawWho(); drawNotice(); await load(); loadSales();
  setInterval(() => { if (!busy) load(); loadSales(); }, 20000);
})();
</script>
